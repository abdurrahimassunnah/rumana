rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // সেশন ট্র্যাকিং (পাবলিকলি ক্রিয়েট ও আপডেট সম্ভব)
    match /app_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId);
      allow delete: if false;
    }

    // গ্লোবাল হিস্ট্রি লগ
    match /global_lesson_history/{historyId} {
      allow read: if true;
      allow create: if isValidId(historyId);
      allow update, delete: if false;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);

      // User's completed history subcollection (exercises, lesson plans, etc)
      match /history/{historyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(historyId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // User's saved books and Table of Contents library
      match /books/{bookId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(bookId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
